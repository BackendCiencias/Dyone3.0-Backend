# Base comun opcional
# Puedes dejar este archivo como referencia y crear tus propios .env.*.local

PORT=4000
JWT_SECRET=replace-with-a-secure-secret

# Desarrollo local:
# Crear .env.development.local con algo como:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dyone_dev?retryWrites=true&w=majority

# Produccion / deploy:
# Configurar en el hosting:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dyone_prod?retryWrites=true&w=majority
